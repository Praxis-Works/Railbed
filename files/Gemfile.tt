source "https://rubygems.org"

gem "bootsnap", "~> 1.0", require: false
gem "fx", "~> 0.11.0"
gem "image_processing", "~> 1.2"
gem "importmap-rails", "~> 2.0"
gem "jbuilder", "~> 2.0"
gem "kamal", "~> 2.0", require: false
gem "pg", "~> 1.1"
gem "propshaft", "~> 1.0"
gem "puma", "~> 8.0"
gem "rails", "~> 8.1.3"
gem "solid_cable", "~> 3.0"
gem "solid_cache", "~> 1.0"
gem "solid_queue", "~> 1.0"
gem "sorbet-runtime", "~> 0.6.13335"
gem "stimulus-rails", "~> 1.0"
gem "strong_migrations", "~> 2.4"
gem "tailwindcss-rails", "~> 4.0"
gem "thruster", "~> 0.1.0", require: false
gem "time_for_a_boolean", "~> 0.3.0"
gem "turbo-rails", "~> 2.0"
gem "tzinfo-data", "~> 1.0", platforms: %i[ windows jruby ]
gem "view_component", "~> 4.12"

group :development, :test do
  gem "brakeman", "~> 8.0", require: false
  gem "bullet", "~> 8.1"
  gem "bundler-audit", "~> 0.9.0", require: false
  gem "debug", "~> 1.0", platforms: %i[ mri windows ], require: "debug/prelude"
  gem "rubocop-factory_bot", "~> 2.28", require: false
  gem "rubocop-rails-omakase", "~> 1.0", require: false
  gem "rubocop-rspec", "~> 3.10", require: false
  gem "rubocop-view_component", "~> 0.6.0", require: false
  gem "rubycritic", "~> 5.0", require: false
  gem "tapioca", "~> 0.19.2", require: false
end

group :development do
  gem "sorbet", "~> 0.6.13335", require: false
  gem "web-console", "~> 4.0"
end

group :test do
  gem "capybara", "~> 3.0"
  gem "factory_bot_rails", "~> 6.5"
  gem "rspec", "~> 3.13"
  gem "rspec-rails", "~> 8.0"
  gem "selenium-webdriver", "~> 4.0"
  gem "shoulda-matchers", "~> 6.5"
  gem "simplecov", "~> 0.22", require: false
  gem "webmock", "~> 3.25"
end
